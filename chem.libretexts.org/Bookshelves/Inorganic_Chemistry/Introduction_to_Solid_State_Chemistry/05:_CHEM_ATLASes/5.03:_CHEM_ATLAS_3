            <td class="mt-align-center lt-chem-408787" data-th="Acetic acid formed">980 mol/hour</td>
        </tr>
        <tr>
            <td class="mt-align-center lt-chem-408787" data-th="\(\mathrm{CO}\) pressure">11.1 atm</td>
            <td class="mt-align-center lt-chem-408787" data-th="\(\mathrm{MeOH}\) pressure">15.0 atm</td>
            <td class="mt-align-center lt-chem-408787" data-th="Acetic acid formed">499 mol/hour</td>
        </tr>
        <tr>
