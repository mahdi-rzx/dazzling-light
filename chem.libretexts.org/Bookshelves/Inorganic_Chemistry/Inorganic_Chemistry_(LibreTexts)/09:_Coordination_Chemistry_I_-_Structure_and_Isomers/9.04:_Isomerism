    <p class="mt-align-center lt-chem-151410"><img alt="clipboard_ebe5f91dc0e17590f272e1f21afe3c0d7.png" style="width: 171px; height: 124px;" width="171px" height="124px" class="internal" loading="lazy" src="https://chem.libretexts.org/@api/deki/files/296958/clipboard_ebe5f91dc0e17590f272e1f21afe3c0d7.png?revision=1&amp;size=bestfit&amp;width=171&amp;height=124" /></p>
