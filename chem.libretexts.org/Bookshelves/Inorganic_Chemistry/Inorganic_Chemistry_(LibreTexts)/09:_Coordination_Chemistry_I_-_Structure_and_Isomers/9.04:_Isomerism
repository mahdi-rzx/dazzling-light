            <td class="mt-noheading lt-chem-151410">AC</td>
            <td class="mt-noheading lt-chem-151410">BD</td>
            <td class="mt-noheading lt-chem-151410">EF</td>
        </tr>
        <tr>
            <td class="mt-noheading lt-chem-151410">5</td>
            <td class="mt-noheading lt-chem-151410">AC</td>
            <td class="mt-noheading lt-chem-151410">BE</td>
            <td class="mt-noheading lt-chem-151410">BF</td>
        </tr>
        <tr>
            <td class="mt-noheading lt-chem-151410">6</td>
            <td class="mt-noheading lt-chem-151410">AC</td>
            <td class="mt-noheading lt-chem-151410">BF</td>
            <td class="mt-noheading lt-chem-151410">DE</td>
        </tr>
        <tr>
            <td class="mt-noheading lt-chem-151410">7</td>
            <td class="mt-noheading lt-chem-151410">AD</td>
            <td class="mt-noheading lt-chem-151410">BC</td>
            <td class="mt-noheading lt-chem-151410">EF</td>
        </tr>
        <tr>
            <td class="mt-noheading lt-chem-151410">8</td>
            <td class="mt-noheading lt-chem-151410">AD</td>
            <td class="mt-noheading lt-chem-151410">BE</td>
            <td class="mt-noheading lt-chem-151410">CF</td>
        </tr>
        <tr>
            <td class="mt-noheading lt-chem-151410">9</td>
