    <p class="mt-align-center lt-chem-151410"><img alt="clipboard_ee1436825e32d0441badae35ba8a22285.png" style="width: 286px; height: 284px;" width="286px" height="284px" class="internal" loading="lazy" src="https://chem.libretexts.org/@api/deki/files/296955/clipboard_ee1436825e32d0441badae35ba8a22285.png?revision=1&amp;size=bestfit&amp;width=286&amp;height=284" /></p>
