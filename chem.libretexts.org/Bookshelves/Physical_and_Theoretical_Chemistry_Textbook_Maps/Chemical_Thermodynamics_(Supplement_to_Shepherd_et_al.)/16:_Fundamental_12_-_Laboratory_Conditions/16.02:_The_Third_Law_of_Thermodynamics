            <td class="mt-column-width-10" data-th="Liquids" style="text-align:center;">&nbsp;</td>
            <td class="mt-colspan mt-column-width-10" style="text-align:center;">&nbsp;</td>
            <td class="mt-column-width-10" data-th="Solids" style="text-align:center;">I<sub>2</sub></td>
