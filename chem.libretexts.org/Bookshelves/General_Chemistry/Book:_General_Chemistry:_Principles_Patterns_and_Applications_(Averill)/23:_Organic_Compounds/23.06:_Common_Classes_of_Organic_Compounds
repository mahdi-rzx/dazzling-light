            <th style="text-align:center;"> </th>
            <th style="text-align:center;"><strong>Name</strong></th>
            <th style="text-align:center;"><strong>Formula</strong></th>
            <th style="text-align:center;"><strong>Molecular Mass (amu)</strong></th>
            <th style="text-align:center;"><strong>Boiling Point (&deg;C)</strong></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td rowspan="3" style="vertical-align:middle;text-align:center;" class="lt-chem-6530"><strong>alkane</strong></td>
