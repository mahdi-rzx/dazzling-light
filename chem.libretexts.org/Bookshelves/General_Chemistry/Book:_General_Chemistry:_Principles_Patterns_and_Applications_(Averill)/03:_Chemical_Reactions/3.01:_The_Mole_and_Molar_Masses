        </tr>
        <tr>
            <td data-th="Atoms" class="lt-chem-19947">2Cl</td>
            <td data-th="Atomic weights" class="lt-chem-19947"><u>(2 atoms)(35.353 amu/atom) = 70.906 amu</u></td>
        </tr>
