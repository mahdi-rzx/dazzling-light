    <li class="qandaentry lt-chem-349761" id="av_1.0-ch17_s01_s03_qa02_qd01_q14_ans"> </li>
    <li class="qandaentry lt-chem-349761" id="av_1.0-ch17_s01_s03_qa02_qd01_q15_ans">
    <div class="answer">
    <ol>
        <li class="lt-chem-349761">8.8 &times; 10<sup>&minus;6</sup></li>
        <li class="lt-chem-349761">6.7 &times; 10<sup>&minus;9</sup></li>
        <li class="lt-chem-349761">9.0 &times; 10<sup>&minus;8</sup></li>
        <li class="lt-chem-349761">2.16 &times; 10<sup>&minus;9</sup></li>
    </ol>
    </div>
    </li>
    <li class="qandaentry lt-chem-349761" id="av_1.0-ch17_s01_s03_qa02_qd01_q16_ans"> </li>
    <li class="qandaentry lt-chem-349761" id="av_1.0-ch17_s01_s03_qa02_qd01_q17_ans">
    <div class="answer">
    <p class="para lt-chem-349761">7.4 &times; 10<sup>&minus;6</sup> M; 2.1 mg</p>
    </div>
    </li>
    <li class="qandaentry lt-chem-349761" id="av_1.0-ch17_s01_s03_qa02_qd01_q18_ans"> </li>
    <li class="qandaentry lt-chem-349761" id="av_1.0-ch17_s01_s03_qa02_qd01_q19_ans">
    <div class="answer">
