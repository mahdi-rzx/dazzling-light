<div class="qandaset block" id="av_1.0-ch16_s02_s05_qa01_ans">
<div mt-section-origin="Bookshelves/General_Chemistry/Book:_General_Chemistry:_Principles_Patterns_and_Applications_(Averill)/16:_Aqueous_AcidBase_Equilibriums/16.02:_A_Qualitative_Description_of__Acid-Base_Equilibria" class="mt-section"><span id="Answer"></span><h3 class="lt-chem-349754 editable">Answer</h3>

<ol class="qandadiv">
    <li class="qandaentry lt-chem-349754" id="av_1.0-ch16_s02_s05_qa01_qd01_q01_ans">
    <div class="answer">
    <ol>
        <li class="lt-chem-349754">\(\overset{\text{acid 1}}{HSO^&minus;_{4(aq)}} + \underset{\text{base 2}}{H_2O_{(l)}} \rightleftharpoons \overset{\text{base 1}}{SO^{2&minus;}_{4(aq)}} + \underset{\text{acid 2}}{H_3O^+_{(aq)}}\)</li>
