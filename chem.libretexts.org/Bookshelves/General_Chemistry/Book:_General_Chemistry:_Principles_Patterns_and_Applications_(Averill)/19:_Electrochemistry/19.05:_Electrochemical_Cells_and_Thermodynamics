            <tr>
                <td align="right" data-th="Titrant (mL)" class="lt-chem-349772">11.00</td>
                <td align="right" data-th="E (mV)" class="lt-chem-349772">1325</td>
            </tr>
            <tr>
                <td align="right" data-th="Titrant (mL)" class="lt-chem-349772">12.00</td>
