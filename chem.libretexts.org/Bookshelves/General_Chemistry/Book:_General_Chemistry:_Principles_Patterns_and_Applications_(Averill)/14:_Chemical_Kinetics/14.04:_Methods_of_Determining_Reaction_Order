            <td align="right" data-th="[A] (M)" class="lt-chem-349740">0.50</td>
            <td align="right" data-th="[B] (M)" class="lt-chem-349740">0.75</td>
            <td align="right" data-th="Initial Rate (M/min)" class="lt-chem-349740">8.5 &times; 10<sup>&minus;3</sup></td>
