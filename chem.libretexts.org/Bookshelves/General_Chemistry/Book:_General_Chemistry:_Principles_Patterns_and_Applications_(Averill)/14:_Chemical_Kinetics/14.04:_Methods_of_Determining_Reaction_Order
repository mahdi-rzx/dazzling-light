            <td align="right" data-th="[I&minus;]0 (M)" class="lt-chem-349740">0.38</td>
            <td align="right" data-th="Initial Rate (M/s)" class="lt-chem-349740">2.05</td>
        </tr>
        <tr>
            <td data-th="Experiment" class="lt-chem-349740">2</td>
            <td align="right" data-th="[S2O82&minus;]0 (M)" class="lt-chem-349740">0.40</td>
            <td align="right" data-th="[I&minus;]0 (M)" class="lt-chem-349740">0.38</td>
            <td align="right" data-th="Initial Rate (M/s)" class="lt-chem-349740">3.06</td>
        </tr>
        <tr>
            <td data-th="Experiment" class="lt-chem-349740">3</td>
            <td align="right" data-th="[S2O82&minus;]0 (M)" class="lt-chem-349740">0.40</td>
            <td align="right" data-th="[I&minus;]0 (M)" class="lt-chem-349740">0.22</td>
