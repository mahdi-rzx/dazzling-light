            <td align="right" data-th="Initial Rate (M/s)" class="lt-chem-349740">1.22 &times; 10<sup>&minus;4</sup></td>
        </tr>
        <tr>
            <td data-th="Experiment" class="lt-chem-349740">2</td>
            <td align="right" data-th="[NO2]0 (M)" class="lt-chem-349740">0.010</td>
            <td align="right" data-th="Initial Rate (M/s)" class="lt-chem-349740">5.40 &times; 10<sup>&minus;5</sup></td>
