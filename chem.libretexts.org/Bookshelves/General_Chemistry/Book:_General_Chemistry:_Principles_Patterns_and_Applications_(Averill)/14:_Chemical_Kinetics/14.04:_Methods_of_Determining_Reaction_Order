            <td align="right" data-th="[NO2]0 (M)" class="lt-chem-349740">0.0080</td>
            <td align="right" data-th="Initial Rate (M/s)" class="lt-chem-349740">3.46 &times; 10<sup>&minus;5</sup></td>
        </tr>
