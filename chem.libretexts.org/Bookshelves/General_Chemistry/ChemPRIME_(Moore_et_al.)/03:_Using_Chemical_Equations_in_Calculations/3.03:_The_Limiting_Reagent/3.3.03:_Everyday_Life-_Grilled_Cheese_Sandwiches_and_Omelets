<p>Option 2: Use all of the bread</p>

<table class="mt-responsive-table">
    <tbody>
        <tr>
            <th>&nbsp;</th>
            <th>cheese</th>
            <th>+ 2 bread</th>
            <th>&rarr; sandwich</th>
        </tr>
        <tr>
            <td class="lt-chem-50065">Starting material (quantity)</td>
            <td class="lt-chem-50065" data-th="cheese">40</td>
            <td class="lt-chem-50065" data-th="+ 2 bread">16</td>
