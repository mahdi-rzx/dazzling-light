            <td class="lt-chem-50065 mt-noheading">--</td>
            <td class="lt-chem-50065 mt-noheading">--</td>
        </tr>
        <tr>
            <td class="lt-chem-50065 mt-noheading">if all Fe<sub>2</sub>O<sub>3</sub> is used</td>
            <td class="lt-chem-50065 mt-noheading">-1.28 x 10<sup>5</sup></td>
            <td class="lt-chem-50065 mt-noheading">-1.92 x 10<sup>5</sup></td>
            <td class="lt-chem-50065 mt-noheading">+1.92 x 10<sup>5</sup></td>
            <td class="lt-chem-50065 mt-noheading">+2.56 x 10<sup>5</sup></td>
        </tr>
        <tr>
            <td class="lt-chem-50065 mt-noheading">Actual Product<br />
            (quantity)</td>
            <td class="lt-chem-50065 mt-noheading">0</td>
            <td class="lt-chem-50065 mt-noheading">4.40 x 10<sup>4</sup></td>
            <td class="lt-chem-50065 mt-noheading">1.92 x 10<sup>5</sup></td>
            <td class="lt-chem-50065 mt-noheading">2.56 x 10<sup>5</sup></td>
        </tr>
    </tbody>
</table>

<p>Option 2: Use all of the carbon</p>

<table class="mt-responsive-table">
    <tbody>
        <tr>
            <td class="lt-chem-50065 mt-noheading">&nbsp;</td>
            <td class="lt-chem-50065 mt-noheading"><b>2 Fe<sub>2</sub>O<sub>3</sub><sub> (s)</sub></b></td>
            <td class="lt-chem-50065 mt-noheading"><b>+ 3 C <sub>(s)</sub></b></td>
            <td class="lt-chem-50065 mt-noheading"><b>&rarr; 3 CO<sub>2 (g)</sub></b></td>
            <td class="lt-chem-50065 mt-noheading"><b>+ 4 Fe <sub>(s)</sub></b></td>
        </tr>
        <tr>
            <td class="lt-chem-50065 mt-noheading">Starting material (mol)</td>
            <td class="lt-chem-50065 mt-noheading">1.28 x 10<sup>5</sup></td>
            <td class="lt-chem-50065 mt-noheading">2.36 x 10<sup>5</sup></td>
            <td class="lt-chem-50065 mt-noheading">--</td>
            <td class="lt-chem-50065 mt-noheading">--</td>
        </tr>
        <tr>
            <td class="lt-chem-50065 mt-noheading">if all carbon is used</td>
            <td class="lt-chem-50065 mt-noheading">-1.57 x 10<sup>5</sup></td>
            <td class="lt-chem-50065 mt-noheading">-2.36 x 10<sup>5</sup></td>
            <td class="lt-chem-50065 mt-noheading">+2.36 x 10<sup>5</sup></td>
            <td class="lt-chem-50065 mt-noheading">+3.15 x 10<sup>5</sup></td>
        </tr>
        <tr>
            <td class="lt-chem-50065 mt-noheading">Actual Product<br />
            (quantity)</td>
            <td bgcolor="#cedff2" class="lt-chem-50065 mt-noheading">-2.9 x 10<sup>4</sup></td>
            <td class="lt-chem-50065 mt-noheading">0</td>
            <td align="center" bgcolor="#cedff2" class="lt-chem-50065 mt-noheading" colspan="2">
            <p class="lt-chem-50065"><b>n/a</b></p>

