            <th class="mt-align-center" scope="col"><strong>Initial Concentration, [H<sub>2</sub>] (mol/L)</strong></th>
            <th class="mt-align-center" scope="col"><strong>Initial Rate of Formation of N<sub>2</sub> (mol/L min)</strong></th>
        </tr>
    </thead>
    <tbody>
        <tr valign="middle">
            <td class="mt-align-center" data-th="Experiment">1</td>
            <td class="mt-align-center" data-th="Initial Concentration [NO] (mol/L)">0.0060</td>
