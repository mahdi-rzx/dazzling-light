            <td class="lt-chem-38322" data-th="Anionic Ligand" style="text-align:center;">\(\ce{C2O4^2-}\)</td>
            <td class="lt-chem-38322" data-th="Name" style="text-align:center;">oxalato</td>
        </tr>
