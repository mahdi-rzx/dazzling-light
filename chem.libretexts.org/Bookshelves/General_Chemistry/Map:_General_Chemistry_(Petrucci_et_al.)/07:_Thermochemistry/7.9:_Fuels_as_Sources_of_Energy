        <tr>
            <td data-th="Fuel" style="text-align:center;" class="lt-chem-6316">crude oil</td>
            <td data-th="&Delta;Hcomb (kJ/g)" style="text-align:center;" class="lt-chem-6316">&minus;43</td>
        </tr>
        <tr>
            <td data-th="Fuel" style="text-align:center;" class="lt-chem-6316">natural gas</td>
            <td data-th="&Delta;Hcomb (kJ/g)" style="text-align:center;" class="lt-chem-6316">&minus;50</td>
        </tr>
        <tr>
            <td data-th="Fuel" style="text-align:center;" class="lt-chem-6316">C<sub>2</sub>H<sub>2</sub> (acetylene)</td>
            <td data-th="&Delta;Hcomb (kJ/g)" style="text-align:center;" class="lt-chem-6316">&minus;50.0</td>
        </tr>
        <tr>
            <td data-th="Fuel" style="text-align:center;" class="lt-chem-6316">CH<sub>4</sub> (methane)</td>
            <td data-th="&Delta;Hcomb (kJ/g)" style="text-align:center;" class="lt-chem-6316">&minus;55.5</td>
