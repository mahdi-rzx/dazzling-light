    color: inherit;
    background: inherit;
	padding: 12px 16px;
	text-decoration: none;
	display: block;
	width: initial;
	text-align: center;
	font-size: 12px;
    margin: 0;
}

/* Change color of dropdown links on hover */
.LTdropdown > .LTdropdown-content a:hover  {
    filter: brightness(85%);
	transition-duration: 250ms;
    color: white;
}

.LTdropdown-content a:before  {
    margin-right: 2px;
}

