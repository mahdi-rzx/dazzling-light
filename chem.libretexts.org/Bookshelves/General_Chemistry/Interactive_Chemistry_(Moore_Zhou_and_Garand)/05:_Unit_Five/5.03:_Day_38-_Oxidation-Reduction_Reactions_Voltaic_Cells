<p class="mt-align-center lt-chem-371707">8 H<sup>+</sup>(aq) + MnO<sub>4</sub><sup>&ndash;</sup>(aq) + 5 Fe<sup>2</sup><sup>+</sup>(aq) &rarr; 5 Fe<sup>3</sup><sup>+</sup>(aq) + Mn<sup>2</sup><sup>+</sup>(aq) + 4 H<sub>2</sub>O(<em>l</em>)</p>

