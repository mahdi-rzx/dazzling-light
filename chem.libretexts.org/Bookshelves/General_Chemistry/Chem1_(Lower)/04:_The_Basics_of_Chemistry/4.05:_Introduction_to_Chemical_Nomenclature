            <th scope="col" style="text-align:center;">C<sub>4</sub></th>
            <th scope="col" style="text-align:center;">C<sub>5</sub></th>
            <th scope="col" style="text-align:center;">C<sub>6</sub></th>
            <th scope="col" style="text-align:center;">C<sub>7</sub></th>
            <th scope="col" style="text-align:center;">C<sub>8</sub></th>
            <th scope="col" style="text-align:center;">C<sub>9</sub></th>
            <th scope="col" style="text-align:center;">C<sub>10</sub></th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td style="text-align:center;" class="lt-chem-3606">meth-</td>
            <td style="text-align:center;" class="lt-chem-3606">eth-</td>
            <td style="text-align:center;" class="lt-chem-3606">prop-</td>
