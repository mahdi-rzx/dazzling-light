            <td style="text-align:center;" class="lt-chem-3602">1+</td>
            <td class="mt-align-center lt-chem-3602">\(\ce{_1^0H^{+}}\) or \(\ce{_1^0p}\)</td>
        </tr>
        <tr>
            <td style="text-align:center;" class="lt-chem-3602">neutron</td>
            <td style="text-align:center;" class="lt-chem-3602">1.6749286 &times; 10<sup>&ndash;24</sup></td>
            <td style="text-align:center;" class="lt-chem-3602">1.008664904</td>
            <td style="text-align:center;" class="lt-chem-3602">0</td>
            <td class="mt-align-center lt-chem-3602">\(\ce{_1^0n}\)</td>
        </tr>
