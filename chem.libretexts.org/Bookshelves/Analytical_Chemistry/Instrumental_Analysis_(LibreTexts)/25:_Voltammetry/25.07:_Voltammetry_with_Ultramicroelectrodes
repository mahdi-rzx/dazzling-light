        </tr>
        <tr>
            <td class="mt-align-center lt-chem-335305" data-th="[L] (M)">0.040</td>
            <td class="mt-align-center lt-chem-335305" data-th="(E1/2)c (V vs. SCE)">&ndash;0.512</td>
        </tr>
        <tr>
            <td class="mt-align-center lt-chem-335305" data-th="[L] (M)">0.060</td>
            <td class="mt-align-center lt-chem-335305" data-th="(E1/2)c (V vs. SCE)">&ndash;0.523</td>
        </tr>
        <tr>
            <td class="mt-align-center lt-chem-335305" data-th="[L] (M)">0.080</td>
            <td class="mt-align-center lt-chem-335305" data-th="(E1/2)c (V vs. SCE)">&ndash;0.530</td>
        </tr>
        <tr>
            <td class="mt-align-center lt-chem-335305" data-th="[L] (M)">0.100</td>
            <td class="mt-align-center lt-chem-335305" data-th="(E1/2)c (V vs. SCE)">&ndash;0.536</td>
        </tr>
