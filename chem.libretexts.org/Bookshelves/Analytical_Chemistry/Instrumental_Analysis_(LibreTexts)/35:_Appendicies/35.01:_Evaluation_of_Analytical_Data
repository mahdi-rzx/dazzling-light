            <th class="mt-align-center" scope="col">\(x_i^2\)</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i\)">0.000</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(y_i\)">0.00</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i y_i\)">0.000</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i^2\)">0.000</td>
        </tr>
        <tr>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i\)">0.100</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(y_i\)">12.36</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i y_i\)">1.236</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i^2\)">0.010</td>
        </tr>
        <tr>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i\)">0.200</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(y_i\)">24.83</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i y_i\)">4.966</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i^2\)">0.040</td>
        </tr>
        <tr>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i\)">0.300</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(y_i\)">35.91</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i y_i\)">10.773</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i^2\)">0.090</td>
        </tr>
        <tr>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i\)">0.400</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(y_i\)">48.79</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i y_i\)">19.516</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i^2\)">0.160</td>
        </tr>
        <tr>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i\)">0.500</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(y_i\)">60.42</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i y_i\)">30.210</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i^2\)">0.250</td>
        </tr>
