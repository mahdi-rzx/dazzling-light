            <th class="mt-align-center" scope="col" style="vertical-align:bottom;">\(y_i\)</th>
            <th class="mt-align-center" scope="col" style="vertical-align:bottom;">\(\hat{y}_i\)</th>
            <th scope="col" style="vertical-align:bottom;" class="mt-align-center  ">\(\left( y_i - \hat{y}_i \right)^2\)</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td class="mt-align-center   lt-chem-363066" data-th="\(x_i\)">0.000</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(y_i\)">0.00</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(\hat{y}_i\)">0.209</td>
            <td class="mt-align-center   lt-chem-363066" data-th="\(\left( y_i - \hat{y}_i \right)^2\)">0.0437</td>
        </tr>
