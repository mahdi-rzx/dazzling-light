.LTdropdown {
	position: relative;
	display: inline-block;
	margin-right: 2px;
    color: white;
    background: black;
}

/* Dropdown Content (Hidden by Default) */
.LTdropdown-content {
    color: inherit;
	display: none;
	position: absolute;
	box-shadow: 0px 8px 16px 0px rgba(0, 0, 0, 0.2);
    background: inherit;
	z-index: 5;
	flex-direction: column;
