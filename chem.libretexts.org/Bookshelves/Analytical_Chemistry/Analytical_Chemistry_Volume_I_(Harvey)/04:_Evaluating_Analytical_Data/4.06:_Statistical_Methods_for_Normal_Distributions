        <tr>
            <td class="mt-align-center mt-noheading lt-chem-127561">1</td>
            <td class="mt-align-center mt-noheading lt-chem-127561">0.430</td>
            <td class="mt-align-center mt-noheading lt-chem-127561">0.415</td>
        </tr>
        <tr>
            <td class="mt-align-center mt-noheading lt-chem-127561">2</td>
            <td class="mt-align-center mt-noheading lt-chem-127561">0.266</td>
            <td class="mt-align-center mt-noheading lt-chem-127561">0.238</td>
        </tr>
        <tr>
            <td class="mt-align-center mt-noheading lt-chem-127561">3</td>
            <td class="mt-align-center mt-noheading lt-chem-127561">0.457</td>
