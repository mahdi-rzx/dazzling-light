        </tr>
        <tr>
            <td class="mt-align-center mt-noheading lt-chem-127561">5</td>
            <td class="mt-align-center mt-noheading lt-chem-127561">0.707</td>
            <td class="mt-align-center mt-noheading lt-chem-127561">0.605</td>
        </tr>
        <tr>
            <td class="mt-align-center mt-noheading lt-chem-127561">6</td>
            <td class="mt-align-center mt-noheading lt-chem-127561">0.716</td>
