            <td class="mt-align-center lt-chem-157675" data-th="&micro;g Cu/mL">0.700</td>
            <td class="mt-align-center lt-chem-157675" data-th="absorbance">0.046</td>
        </tr>
        <tr>
            <td class="mt-align-center lt-chem-157675" data-th="&micro;g Cu/mL">0.300</td>
