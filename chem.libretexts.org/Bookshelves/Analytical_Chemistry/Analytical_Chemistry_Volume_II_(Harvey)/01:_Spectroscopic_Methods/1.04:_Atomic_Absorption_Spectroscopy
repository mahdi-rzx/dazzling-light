            <td class="mt-align-center lt-chem-157675" data-th="&micro;g Cu/mL">0.500</td>
            <td class="mt-align-center lt-chem-157675" data-th="absorbance">0.033</td>
        </tr>
        <tr>
            <td class="mt-align-center lt-chem-157675" data-th="&micro;g Cu/mL">0.100</td>
            <td class="mt-align-center lt-chem-157675" data-th="absorbance">0.006</td>
            <td class="mt-align-center lt-chem-157675" data-th="&micro;g Cu/mL">0.600</td>
