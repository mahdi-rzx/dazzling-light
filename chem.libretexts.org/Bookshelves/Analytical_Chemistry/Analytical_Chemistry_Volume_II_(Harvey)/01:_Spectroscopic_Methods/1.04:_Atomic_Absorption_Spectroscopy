            <td class="mt-align-center lt-chem-157675" data-th="absorbance">0.026</td>
            <td class="mt-align-center lt-chem-157675" data-th="&micro;g Cu/mL"> </td>
            <td class="mt-align-center lt-chem-157675" data-th="absorbance"> </td>
        </tr>
