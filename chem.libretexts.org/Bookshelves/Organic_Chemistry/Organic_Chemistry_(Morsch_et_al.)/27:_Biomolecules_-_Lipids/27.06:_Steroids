        </tr>
        <tr>
            <td class="mt-align-center lt-chem-36487" data-th="Hormone"><img alt="testosterone.jpg" style="width: 200px; height: 102px; max-width: 748px;" width="200px" height="102px" class="internal" loading="lazy" src="https://chem.libretexts.org/@api/deki/files/25899/testosterone.jpg?revision=1&amp;size=bestfit&amp;width=200&amp;height=102" /></td>
