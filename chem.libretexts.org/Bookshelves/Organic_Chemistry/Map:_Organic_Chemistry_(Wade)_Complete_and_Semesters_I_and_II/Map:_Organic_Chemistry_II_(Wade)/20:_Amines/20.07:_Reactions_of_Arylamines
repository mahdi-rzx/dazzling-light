            <td class="mt-noheading mt-column-width-10"><img src="http://www2.chemistry.msu.edu/faculty/reusch/VirtTxtJml/Images/arroweq3.gif" /></td>
            <td class="mt-noheading mt-column-width-30" nowrap="nowrap">C<sub>6</sub>H<sub>5</sub>N<sub>2</sub>&ndash;O<sup>(&ndash;)</sup> Na<sup>(+)</sup></td>
