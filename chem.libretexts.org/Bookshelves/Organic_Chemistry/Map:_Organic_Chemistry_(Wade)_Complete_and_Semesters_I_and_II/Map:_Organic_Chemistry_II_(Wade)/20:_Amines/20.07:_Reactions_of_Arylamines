        <tr>
            <td class="mt-noheading mt-column-width-30" nowrap="nowrap">C<sub>6</sub>H<sub>5</sub>N<sub>2</sub><sup>(+)</sup> HSO<sub>4</sub><sup>(&ndash;)</sup> + NaOH (cold solution)</td>
