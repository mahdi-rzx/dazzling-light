    <tbody>
        <tr align="center">
            <td class="mt-noheading" nowrap="nowrap"><br />
            Ar-N<sub>2</sub><sup>(+)</sup> X<sup>(&ndash;)</sup></td>
            <td class="mt-noheading mt-column-width-10" width="90">NaHSO<sub>3</sub><br />
            <img src="http://www2.chemistry.msu.edu/faculty/reusch/VirtTxtJml/Images/arrow2.gif" /></td>
            <td class="mt-noheading mt-column-width-15" nowrap="nowrap"><br />
            Ar-N=N-SO<sub>3</sub>H</td>
