            <td class="mt-noheading" nowrap="nowrap"><br />
            Ar-NH-NH-SO<sub>3</sub>H</td>
            <td class="mt-noheading" width="80">H<sub>2</sub>O<br />
            <img src="http://www2.chemistry.msu.edu/faculty/reusch/VirtTxtJml/Images/arrow2.gif" /></td>
            <td class="mt-noheading" nowrap="nowrap"><br />
            Ar-NH-NH<sub>2</sub> + H<sub>2</sub>SO<sub>4</sub></td>
        </tr>
