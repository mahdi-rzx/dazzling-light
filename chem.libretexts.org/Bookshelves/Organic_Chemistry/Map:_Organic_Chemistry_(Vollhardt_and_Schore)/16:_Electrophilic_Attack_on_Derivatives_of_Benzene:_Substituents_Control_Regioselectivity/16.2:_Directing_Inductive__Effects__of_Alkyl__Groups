        </tr>
        <tr>
            <td data-th="Substrate" class="lt-chem-31577">tert-butylbenzene</td>
            <td data-th="% ortho" style="text-align:center;" class="lt-chem-31577">16</td>
            <td data-th="% para" style="text-align:center;" class="lt-chem-31577">73</td>
