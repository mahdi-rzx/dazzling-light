        </tr>
        <tr>
            <td data-th="Substrate" class="lt-chem-31577">ethylbenzene</td>
            <td data-th="% ortho" style="text-align:center;" class="lt-chem-31577">45</td>
            <td data-th="% para" style="text-align:center;" class="lt-chem-31577">49</td>
